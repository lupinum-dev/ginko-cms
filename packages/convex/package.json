{
  "name": "@lupinum/ginko-cms-convex",
  "version": "0.2.0-rc.1",
  "description": "Convex component for ginko-cms",
  "homepage": "https://github.com/lupinum-dev/ginko-cms#readme",
  "bugs": {
    "url": "https://github.com/lupinum-dev/ginko-cms/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lupinum-dev/ginko-cms.git",
    "directory": "packages/convex"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "import": "./dist/component/convex.config.js"
    },
    "./convex.auth": {
      "types": "./dist/convex.auth.d.ts",
      "import": "./dist/convex.auth.js"
    },
    "./mcp": {
      "types": "./dist/mcpHandler.d.ts",
      "import": "./dist/mcpHandler.js"
    },
    "./component": {
      "types": "./dist/_generated/component.d.ts",
      "import": "./dist/_generated/component.js"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "import": "./dist/operations.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/build-component-entrypoints.mjs",
    "codegen": "pnpm --dir ../.. exec convex codegen --component-dir packages/convex/src",
    "prepack": "pnpm run build",
    "prepare:component": "pnpm run codegen",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.type-tests.json"
  },
  "dependencies": {
    "@better-convex/mcp": "0.1.0-beta.2",
    "@lupinum/ginko-cms-contract": "workspace:^0.2.0-rc.1",
    "@lupinum/ginko-content": "^0.3.0-rc.5",
    "better-convex-nuxt": "0.8.0-beta.11",
    "convex": "1.42.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "better-auth": "1.7.0-rc.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
