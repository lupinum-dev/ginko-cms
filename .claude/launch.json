{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "playground",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "studio-vite",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "packages/cms",
        "exec",
        "vite",
        "--config",
        "studio-app/vite.config.ts",
        "--port",
        "5252"
      ],
      "port": 5252,
      "autoPort": false
    },
    {
      "name": "playground-hmr",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "GINKO_STUDIO_DEV_SERVER=http://localhost:5252",
        "pnpm",
        "--dir",
        "playground",
        "exec",
        "nuxi",
        "dev",
        "--dotenv",
        ".env.local"
      ],
      "port": 3000,
      "autoPort": false
    }
  ]
}
