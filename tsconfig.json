{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "#component/*": ["./packages/convex/src/*"],
      "#runtime/*": ["./packages/cms/src/runtime/*"],
      "@lupinum/ginko-cms-contract/shared/*.js": ["./packages/contract/src/*.ts"],
      "@lupinum/ginko-cms-contract/shared/*": ["./packages/contract/src/*"],
      "@lupinum/ginko-cms-convex/operation-handles/mcp": [
        "./packages/convex/src/generated/operationHandles/mcp.ts"
      ],
      "@lupinum/ginko-cms-convex/*": ["./packages/convex/src/*"],
      "@lupinum/ginko-cms": ["./packages/cms/src/module.ts"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.vue", "test/**/*.ts"],
  "exclude": ["dist", "node_modules", "packages/*/dist", "playground"]
}
